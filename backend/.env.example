APP_ENV=development
SERVER_PORT=8080
DATABASE_URL=postgres://freedinner:freedinner@localhost:5432/freedinner_agent?sslmode=disable
JWT_SECRET=change_me_to_a_long_random_string
API_KEY_ENCRYPTION_KEY=32_byte_base64_or_hex_key
WORKSPACE_ROOT=./.workspaces
WORKSPACE_SANDBOX_IMAGE=freedinner-agent-sandbox:latest
WORKSPACE_DOCKER_BINARY=docker
WORKSPACE_PODMAN_BINARY=podman
WORKSPACE_NSJAIL_BINARY=nsjail
